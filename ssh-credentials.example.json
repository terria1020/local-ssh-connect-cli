{
  "$schema": "./ssh-credentials.schema.json",
  "version": "1.0",
  "description": "SSH credentials for local-ssh-connect-cli",
  "credentials": [
    {
      "id": "example-key-server",
      "name": "Example server (key auth)",
      "host": "example.com",
      "port": 22,
      "username": "ubuntu",
      "authType": "key",
      "privateKeyPath": "/Users/you/.ssh/id_rsa",
      "passphrase": "YmFzZTY0X2VuY29kZWRfcGFzc3BocmFzZQ==",
      "note": "Base64 passphrase is optional."
    },
    {
      "id": "example-password-server",
      "name": "Example server (password auth)",
      "host": "example.com",
      "port": 22,
      "username": "admin",
      "authType": "password",
      "password": "YmFzZTY0X2VuY29kZWRfcGFzc3dvcmQ=",
      "note": "Password auth requires sshpass installed."
    }
  ]
}
