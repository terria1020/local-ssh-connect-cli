{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SSH Credentials",
  "description": "SSH credentials configuration for local-ssh-connect-cli",
  "type": "object",
  "required": ["version", "credentials"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "description": {
      "type": "string"
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/credential"
      }
    }
  },
  "definitions": {
    "credential": {
      "type": "object",
      "required": ["id", "name", "host", "username", "authType"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "username": {
          "type": "string"
        },
        "authType": {
          "type": "string",
          "enum": ["key", "password"]
        },
        "privateKeyPath": {
          "type": "string"
        },
        "passphrase": {
          "type": "string",
          "description": "Base64 encoded passphrase of the private key (authType \"key\" only). Answered non-interactively through a temporary SSH_ASKPASS helper; never written to argv or disk."
        },
        "password": {
          "type": "string",
          "description": "Base64 encoded SSH password (sshpass required)"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authType": { "const": "key" }
            }
          },
          "then": {
            "required": ["privateKeyPath"]
          }
        },
        {
          "if": {
            "properties": {
              "authType": { "const": "password" }
            }
          },
          "then": {
            "required": ["password"]
          }
        }
      ]
    }
  }
}
